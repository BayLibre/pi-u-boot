/dts-v1/;

/ {
	description = "ZhiHe A210 Boot FIT image";
	#address-cells = <1>;

	images {
		fdt {
			description = "DEV Device Tree";
			data = /incbin/("replace-path/a210.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			load = <0x8c000000>;
			hash {
				algo = "sha256";
			};
		};

		opensbi {
			description = "RISC-V OpenSBI";
			data = /incbin/("replace-path/fw_dynamic.bin.gz");
			type = "firmware";
			os = "opensbi";
			arch = "riscv";
			compression = "gzip";
			load = <0x80000000>;
			entry = <0x80000000>;
			hash {
				algo = "sha256";
			};
		};

		u-boot {
			description = "U-Boot";
			data = /incbin/("replace-path/u-boot.bin.gz");
			type = "firmware";
			os = "u-boot";
			arch = "riscv";
			compression = "gzip";
			load = <0x90000000>;
			entry = <0x90000000>;
			hash {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "a210";
		a210 {
			description = "A210 Configuration";
			fdt = "fdt";
			firmware = "opensbi";
			loadables = "u-boot";
			invalid_signature {
				algo = "sha256,rsa2048";
				key-name-hint = "signature_key_name";
				sign-images = "fdt", "firmware", "uboot";
			};
		};
	};
};
