/* SpacemiT K3 Android boot environment, modelled on env/ti/android.env.
 *
 * Included from board/spacemit/k3/k3.env when CONFIG_BOOTMETH_ANDROID is
 * enabled. Overrides the distro bootcmd to drive the BOOTSTD Android bootmeth
 * on UFS (scsi). The K3 DRAM base is 4 GiB, so the Android image blob load
 * addresses (low) are ignored via CONFIG_ANDROID_BOOT_IMAGE_IGNORE_BLOB_ADDR
 * and the bootloader picks the addresses below instead.
 */

/* Only scan UFS, and only with the Android bootmeth: skips the global efi_mgr
 * and the distro/extlinux methods (faster, and avoids their heap use before
 * AVB verification). */
boot_targets=scsi
bootmeths=android

/* Load addresses for the raw boot / vendor_boot images (must be in DRAM,
 * i.e. >= 0x102000000 on K3, clear of ramdisk/fdt/kernel/avb buffers). */
loadaddr=0x180000000
vendor_boot_comp_addr_r=0x190000000

bootcmd=bootflow scan -lb
